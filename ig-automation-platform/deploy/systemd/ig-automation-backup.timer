# Daily database backup at ~02:30 server time. Missed runs (server off) catch up on boot.
#   systemctl list-timers ig-automation-backup.timer
[Unit]
Description=Daily Reel Automation database backup

[Timer]
OnCalendar=*-*-* 02:30:00
RandomizedDelaySec=15min
Persistent=true

[Install]
WantedBy=timers.target
