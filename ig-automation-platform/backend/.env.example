# ─── Copy to backend/.env and fill in.  NEVER commit the real .env ───
# Generate secrets with:  npm run gen-secrets

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Public HTTPS URL where the app is reachable. Instagram redirects here after login, so it
# must be HTTPS. In dev, use your tunnel URL (see docs/PHASE-2-META-SETUP.md) for BOTH values,
# e.g. https://abc123.ngrok-free.app — the tunnel points at the Vite dev server, which
# proxies /api to this backend, so dashboard + API share one origin.
# OAuth redirect URI to register in Meta = APP_BASE_URL + /api/instagram/oauth/callback
APP_BASE_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
# true when running behind Nginx (production)
TRUST_PROXY=false

# ─── MySQL (matches docker-compose.yml defaults) ───
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=igauto
DB_PASSWORD=igauto_dev_password
DB_NAME=ig_automation
DB_POOL_MAX=10

# ─── Admin auth ───
JWT_SECRET=replace-with-output-of-npm-run-gen-secrets-min-32-chars
JWT_EXPIRES_IN=12h

# 32 random bytes, base64. Encrypts Instagram access tokens at rest.
ENCRYPTION_KEY=replace-with-output-of-npm-run-gen-secrets

# ─── Instagram API with Instagram Login (Phase 2) ───
# App Dashboard → Instagram → API setup with Instagram login → "Instagram app ID" / "Instagram app secret"
# (these are NOT the Meta App ID / App secret at the top of the dashboard)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Phase 3: any random string you choose; you paste the same value into the Meta webhook config
META_WEBHOOK_VERIFY_TOKEN=
# Latest version listed at https://developers.facebook.com/docs/graph-api/changelog
META_GRAPH_API_VERSION=v26.0

# ─── Claude AI (Phase 5) ───
# From https://platform.claude.com → API keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
