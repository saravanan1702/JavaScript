# ─── Copy to backend/.env and fill in.  NEVER commit the real .env ───
# Generate secrets with:  npm run gen-secrets

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Public HTTPS URL of the backend. In dev, your tunnel URL (Phase 3), e.g. https://abc123.ngrok-free.app
APP_BASE_URL=http://localhost:4000
# Where the dashboard runs (CORS + redirect after Instagram connect)
FRONTEND_URL=http://localhost:5173
# true when running behind Nginx (production)
TRUST_PROXY=false

# ─── MySQL (matches docker-compose.yml defaults) ───
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=igauto
DB_PASSWORD=igauto_dev_password
DB_NAME=ig_automation
DB_POOL_MAX=10

# ─── Admin auth ───
JWT_SECRET=replace-with-output-of-npm-run-gen-secrets-min-32-chars
JWT_EXPIRES_IN=12h

# 32 random bytes, base64. Encrypts Instagram access tokens at rest.
ENCRYPTION_KEY=replace-with-output-of-npm-run-gen-secrets

# ─── Meta / Instagram (Phase 2) ───
# From developers.facebook.com → your app → App settings / Instagram → API setup with Instagram login
META_APP_ID=
META_APP_SECRET=
# Any random string you choose; you paste the same value into the Meta webhook config
META_WEBHOOK_VERIFY_TOKEN=
# Use the latest version listed at https://developers.facebook.com/docs/graph-api/changelog
META_GRAPH_API_VERSION=v24.0

# ─── Claude AI (Phase 5) ───
# From https://platform.claude.com → API keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
